# Server-only. Never prefix with NEXT_PUBLIC_.
# Development/test use mock mode when this is unset. Production fails closed
# unless the authenticated P1 BFF variables below are configured.
GEMINI_API_KEY=

# Optional server configuration.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# P1 web BFF. Leave unset only for the local P0 mock/Gemini path.
# These values are server-only; do not prefix them with NEXT_PUBLIC_.
P1_API_URL=
APP_ORIGIN=http://localhost:3000
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
